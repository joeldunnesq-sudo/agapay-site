{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agapay-accounting-provisioner",
  "main": "src/accounting/provisioning/worker.js",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "AGAPAY_ENVIRONMENT": "production",
    "PARISH_PORTABILITY_ENABLED": "true",
    "CLOUDFLARE_ACCOUNT_ID": "9198ae5ea8adc59e5dedd1b09c9478b9"
  },
  "d1_databases": [
    {
      "binding": "AGAPAY_DB",
      "database_name": "agapay-production",
      "database_id": "24f514a6-6904-425b-a4c8-b3584b23c0be"
    }
  ],
  "workflows": [
    {
      "binding": "ACCOUNTING_ACTIVATION",
      "name": "agapay-accounting-activation",
      "class_name": "AccountingProvisioningWorkflow"
    }
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
}
