{
  "id": "/myagapay/",
  "name": "My AGAPAY",
  "short_name": "My AGAPAY",
  "description": "Love how you give, learn, and live.",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["finance", "lifestyle", "education"],
  "start_url": "/myagapay/login?source=pwa",
  "scope": "/myagapay/",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "portrait-primary",
  "background_color": "#061522",
  "theme_color": "#061522",
  "icons": [
    {
      "src": "/images/app/apple-touch-icon-blue.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/app/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/app/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/app/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/images/app/screenshots/giving-dashboard.jpg",
      "sizes": "1440x3120",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "My AGAPAY giving dashboard"
    },
    {
      "src": "/images/app/screenshots/today-in-the-church.jpg",
      "sizes": "1440x3120",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Today in the Church calendar"
    },
    {
      "src": "/images/app/screenshots/parish-bookstore.jpg",
      "sizes": "1440x3120",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Parish bookstore checkout"
    }
  ],
  "shortcuts": [
    {
      "name": "Give",
      "short_name": "Give",
      "description": "Open the My AGAPAY giving dashboard.",
      "url": "/myagapay",
      "icons": [
        {
          "src": "/images/app/shortcuts/give-v2.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Today",
      "short_name": "Today",
      "description": "View today's Church calendar, readings, and saints.",
      "url": "/myagapay/calendar",
      "icons": [
        {
          "src": "/images/app/shortcuts/today-v2.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Bookstore",
      "short_name": "Bookstore",
      "description": "Open the My AGAPAY parish bookstore.",
      "url": "/myagapay/bookstore",
      "icons": [
        {
          "src": "/images/app/shortcuts/bookstore-v2.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Directory",
      "short_name": "Directory",
      "description": "Open the Orthodox parish and community directory.",
      "url": "/myagapay/directory",
      "icons": [
        {
          "src": "/images/app/shortcuts/directory-v2.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}
