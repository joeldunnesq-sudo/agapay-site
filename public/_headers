# Applied by Cloudflare's static-asset layer to every response served
# from public/ -- this covers HTML pages, JS, and CSS. It does NOT cover
# API responses the Worker constructs directly (those get the identical
# header set via SECURITY_HEADERS in src/lib/core.js's json()/corsJson()).
# See docs/SECURITY_HEADERS.md for why both mechanisms are needed and
# what each one covers.
#
# Keep this policy in sync with SECURITY_HEADERS in src/lib/core.js.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=2592000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=(self), payment=(self), fullscreen=(self "https://www.youtube.com" "https://www.youtube-nocookie.com")
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com https://static.cloudflareinsights.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://challenges.cloudflare.com https://*.cloudflarestream.com https://www.facebook.com; media-src 'self' https://*.cloudflarestream.com; frame-src https://challenges.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'

# This one public surface is intentionally embeddable on organization websites.
# Keep every other AGAPAY page under the SAMEORIGIN policy above.
/give/embed.html
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors *
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# The Worker rewrites clean public URLs to the asset above, but Cloudflare
# matches _headers against the original request URL. Keep the clean route in
# lockstep with the physical asset rule so third-party iframes are permitted.
/give/embed/*
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors *
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Small public loader copied into customer websites. Keep this cross-origin,
# version-light, and cache briefly so fixes roll out without snippet changes.
/giving-box.js
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=3600, must-revalidate

# Browsers check this file for updates independently of the app-shell cache.
/service-worker.js
  Cache-Control: no-cache

# The default max-age=0/must-revalidate above has no ETag/Last-Modified
# validator on these HTML files, which some mobile WebViews (notably
# iOS home-screen PWAs) treat leniently and serve stale from local disk
# cache despite must-revalidate. These app-shell paths are already
# treated as network-only/uncacheable by service-worker.js -- make the
# HTTP layer say the same thing explicitly so no cache (browser, carrier
# proxy, CDN edge) is tempted to reuse an old page after a deploy.
/myagapay/*
  Cache-Control: no-store
/parish/*
  Cache-Control: no-store

# Keep authenticated, administrative, and sign-in surfaces out of search.
# Public Give marketing pages and parish giving URLs remain indexable.
/admin*
  X-Robots-Tag: noindex, nofollow
/myagapay/*
  X-Robots-Tag: noindex, nofollow
/donor/*
  X-Robots-Tag: noindex, nofollow
/parish/*
  X-Robots-Tag: noindex, nofollow
/give/login*
  X-Robots-Tag: noindex, nofollow

# These shared files are referenced with explicit ?v= release identifiers on
# every My AGAPAY page. Their URLs change whenever their contents change, so
# repeat navigations can safely reuse them without revalidation.
/donor/style.css
  Cache-Control: public, max-age=31536000, immutable
/donor/app.js
  Cache-Control: public, max-age=31536000, immutable
/myagapay-shell.js
  Cache-Control: public, max-age=31536000, immutable
