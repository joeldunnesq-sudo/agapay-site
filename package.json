{
  "name": "agapay-site",
  "version": "0.1.0",
  "private": true,
  "description": "AGAPAY Orthodox giving platform frontend and API foundation.",
  "type": "module",
  "scripts": {
    "assets:version": "node scripts/version-app-assets.mjs",
    "assets:check": "node scripts/version-app-assets.mjs --check",
    "predev": "npm run build:server && npm run build:browser && npm run assets:version",
    "prestart": "npm run build:server && npm run build:browser && npm run assets:version",
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:changed": "node scripts/run-tests.mjs changed",
    "test:parish-ui": "node scripts/run-tests.mjs parish-ui",
    "test:sacraments": "node scripts/run-tests.mjs sacraments",
    "lint": "node scripts/lint.mjs --cache",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "quality": "npm run build:server:check && npm run build:browser:check && npm run typecheck && npm run assets:check && npm run lint -- --no-cache && node scripts/lint-warning-baseline-tests.mjs && npm run format:check && node scripts/source-size-budget-tests.mjs && node scripts/accounting-migration-ledger-tests.mjs",
    "test:festal-alms": "node scripts/festal-alms-tests.mjs",
    "test:parish-feature-requests": "node scripts/parish-feature-request-tests.mjs",
    "test:mfa": "node scripts/privileged-mfa-tests.mjs",
    "test:consumer-passkeys": "node scripts/consumer-passkey-tests.mjs",
    "precheck": "node scripts/run-tests.mjs precheck",
    "check": "node scripts/run-tests.mjs all",
    "check:core": "node scripts/run-tests.mjs core",
    "check:accounting": "node scripts/run-tests.mjs accounting",
    "check:product-ui": "node scripts/run-tests.mjs product-ui",
    "check:directory": "node scripts/run-tests.mjs directory",
    "check:release-gates": "node scripts/run-tests.mjs release-gates",
    "check:critical": "node scripts/run-tests.mjs critical",
    "accounting:env": "node scripts/accounting-env-check.mjs",
    "accounting:migration-plan": "node scripts/accounting-migration-guard.mjs",
    "stripe:setup-give-plans": "node scripts/setup-give-stripe-plans.mjs",
    "prelaunch": "node scripts/prelaunch-checks.mjs",
    "test:directory-import": "node scripts/directory-import-tests.mjs",
    "test:parish-portability": "node scripts/parish-portability-tests.mjs",
    "test:parish-portability-runtime": "node scripts/parish-portability-runtime-tests.mjs",
    "test:parish-portability-browser": "node scripts/portability-browser-gate.mjs",
    "test:portability-query-budget": "node scripts/portability-query-budget.mjs",
    "test:portability-volume": "node scripts/portability-volume-gate.mjs",
    "test:parish-browser": "node scripts/parish-dashboard-browser-tests.mjs && node scripts/parish-onboarding-browser-tests.mjs && node scripts/parish-campaign-browser-tests.mjs && node scripts/parish-stewardship-browser-tests.mjs && node scripts/parish-giving-browser-tests.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "build:server": "node scripts/build-server-typescript.mjs",
    "build:server:check": "node scripts/build-server-typescript.mjs --check",
    "build:browser": "node scripts/build-browser-typescript.mjs",
    "build:browser:check": "node scripts/build-browser-typescript.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@cf-wasm/photon": "^0.4.0",
    "@cloudflare/puppeteer": "^1.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "dompurify": "^3.4.16",
    "pdf-lib": "^1.17.1",
    "svix": "^2.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "0.28.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "miniflare": "5.20260930.0-alpha",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "wrangler": "^4.145.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "@types/node": "24.19.0"
  },
  "overrides": {
    "@cloudflare/puppeteer": {
      "@puppeteer/browsers": "3.2.0"
    }
  }
}
