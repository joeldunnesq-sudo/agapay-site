node_modules/

# package-lock.json is intentionally tracked (not ignored) as of Package
# 0.75A (CI Safety) -- the CI test gate uses `npm ci`, which requires a
# committed lockfile for deterministic installs. Do not re-add this to
# .gitignore without providing another deterministic-install mechanism.

# Local scratch files created during Codex/Claude iterations
index-script-snippet.txt
tmp-*/

# Local logs and environment files
*.log
.eslintcache
.env
.env.*
.dev.vars
.wrangler/

# Browser evidence generated by release-gate and smoke scripts
artifacts/

# Mobile-store signing material and generated release bundles
*.jks
*.keystore
*.p12
*.mobileprovision
*.cer
*.aab
*.apk
*.ipa
android/local.properties
store/**/signing.properties
